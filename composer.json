{
    "name": "slim/api-base",
    "description": "API REST Base con Slim Framework y buenas prácticas",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.6",
        "firebase/php-jwt": "^6.0",
        "php-di/php-di": "^7.0",
        "symfony/dotenv": "^6.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public",
        "test": "phpunit"
    }
}
